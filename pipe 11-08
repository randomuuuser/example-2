def ablate(rows, target="wer", n_splits=5):
    """
    Feature-block ablation with call-grouped cross-validation.

    Read it top to bottom: if 'proxy only' is not far above 'baseline (mean)',
    the proxies are not informative on this corpus and nothing downstream will
    rescue that.
    """
    import pandas as pd

    from evaluate import ablation, denominator_bias

    report("denominator drift (n_ref / n_hyp)",
           sorted(denominator_bias(rows).items()))
    table = pd.DataFrame(ablation(rows, target=target, n_splits=n_splits))
    print(f"\nablation, target={target}, grouped by call")
    print(table.to_string(index=False))
    return table


def evaluate(rows, target="wer", model="hgb", blocks=("proxy", "text"),
             n_splits=5, importance=True):
    """Full report for one configuration: segments, calls, feature ranking."""
    import pandas as pd

    from evaluate import (call_metrics, cross_validate, permutation_importance,
                          segment_metrics)

    result = cross_validate(rows, blocks=blocks, target=target, model=model,
                            n_splits=n_splits)
    report(f"segment level ({result['n_folds']} folds, "
           f"{result['n_features']} features)",
           [(k, round(v, 4)) for k, v in segment_metrics(result).items()])

    calls, summary = call_metrics(result)
    print("\nper call, duration-weighted")
    print(pd.DataFrame(calls).to_string(index=False))
    report("call level", [(k, round(v, 4) if isinstance(v, float) else v)
                          for k, v in summary.items()])

    if importance:
        base, scores = permutation_importance(
            rows, blocks=blocks, target=target, n_splits=n_splits, n_repeats=3
        )
        report(f"permutation importance (base MAE {base:.4f})",
               [(name, f"+{delta:.4f}") for name, delta, _ in scores[:10]])

    return result


def compare_proxies(rows, target="wer", n_splits=5):
    """
    Each proxy alone, then both.

    Watch for a proxy that helps far less than its solo score suggests once
    combined - that is the signature of errors correlated with the target.
    """
    import pandas as pd

    from evaluate import single_proxy_ablation

    table = pd.DataFrame(single_proxy_ablation(rows, target=target,
                                               n_splits=n_splits))
    print("\nproxy contribution")
    print(table.to_string(index=False))
    return table


def diagnose(rows, min_hyp_words=3):
    """
    Check whether the score comes from real WER estimation or from detecting
    collapsed transcriptions.

    Run this whenever denominator_bias shows a large ratio_p90: it means a
    cluster of segments where the target produced almost nothing, which scores
    WER 1 and is trivially detectable from the hypothesis length alone.
    """
    from diagnostics import report_all

    report_all(rows, min_hyp_words=min_hyp_words)


def worst(rows, n=10):
    """The segments the model misses hardest, with their texts."""
    import pandas as pd

    from diagnostics import worst_predictions

    table = pd.DataFrame(worst_predictions(rows, n=n))
    print(table.to_string(index=False))
    return table


def tail(rows):
    """Size of the right tail of the WER labels, and its share of the variance."""
    import pandas as pd

    from diagnostics import label_tail_report

    table = pd.DataFrame(label_tail_report(rows))
    print(table.to_string(index=False))
    return table


def clipped(rows, max_wer=1.0):
    """Rows with the WER label capped - compare ablations with and without."""
    from diagnostics import clip_labels

    return clip_labels(rows, max_wer=max_wer)


