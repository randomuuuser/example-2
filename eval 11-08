BAD_THRESHOLD = 0.25


def regression_metrics(y_true, y_pred, mape_floor=0.02):
    """
    Full regression report for a WER estimate.

    R2 is stricter than Pearson: a prediction perfectly correlated with the
    truth but systematically offset scores high on Pearson and low on R2.
    Negative R2 means the estimator is worse than predicting the mean.

    MAPE is the mean relative error - the same quantity as WERR. It is only
    meaningful when the truth stays away from zero, so values below mape_floor
    are excluded and the count of excluded points is reported.

    bias is the mean SIGNED error: MAE says how far off, bias says in which
    direction. A systematic under-estimate is invisible in MAE.
    """
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    residual = y_pred - y_true

    usable = y_true > mape_floor
    mape = (float(np.mean(np.abs(residual[usable] / y_true[usable])))
            if usable.any() else None)

    return {
        "n": len(y_true),
        "MAE": float(np.mean(np.abs(residual))),
        "RMSE": float(np.sqrt(np.mean(residual ** 2))),
        "R2": float(r2_score(y_true, y_pred)),
        "MAPE": mape,
        "MAPE_excluded": int((~usable).sum()),
        "bias": float(np.mean(residual)),
        "pearson": float(stats.pearsonr(y_true, y_pred)[0]),
        "spearman": float(stats.spearmanr(y_true, y_pred)[0]),
        "kendall": float(stats.kendalltau(y_true, y_pred)[0]),
    }


def binary_metrics(y_true, y_pred, threshold=BAD_THRESHOLD):
    """
    Good / bad verdict: a transcription is 'bad' when its WER exceeds threshold.

    Two families are reported side by side.

    Ranking metrics (ROC_AUC, PR_AUC) use the predicted WER as a continuous
    score and never binarise it, so they answer 'does the estimate rank bad
    transcriptions above good ones' independently of any decision cut-off.
    PR_AUC must be compared to 'prevalence' - that is what a random ranker
    reaches - never to 0.5.

    Decision metrics binarise the prediction at the SAME threshold and answer
    'if I act on this verdict, how often am I right'. MCC is the one to lead
    with under class imbalance: it stays near 0 for a trivial classifier that
    always predicts the majority class, where accuracy would look high.
    """
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    true_bad = (y_true > threshold).astype(int)
    pred_bad = (y_pred > threshold).astype(int)

    report = {
        "threshold": threshold,
        "n": len(y_true),
        "n_bad_true": int(true_bad.sum()),
        "prevalence": float(true_bad.mean()),
        "n_bad_pred": int(pred_bad.sum()),
    }

    if 0 < true_bad.sum() < len(true_bad):
        report.update({
            "ROC_AUC": float(roc_auc_score(true_bad, y_pred)),
            "PR_AUC": float(average_precision_score(true_bad, y_pred)),
            "precision": float(precision_score(true_bad, pred_bad, zero_division=0)),
            "recall": float(recall_score(true_bad, pred_bad, zero_division=0)),
            "F1": float(f1_score(true_bad, pred_bad, zero_division=0)),
            "balanced_accuracy": float(balanced_accuracy_score(true_bad, pred_bad)),
            "MCC": float(matthews_corrcoef(true_bad, pred_bad)),
        })
    else:
        report["note"] = "single class at this threshold - ranking metrics undefined"

    matrix = confusion_matrix(true_bad, pred_bad, labels=[0, 1])
    return report, matrix


def precision_at_k(y_true, y_pred, k, threshold=BAD_THRESHOLD):
    """
    Share of genuinely bad transcriptions among the k worst-ranked ones.

    The metric for a selection workflow: only the head of the ranking is ever
    acted on, so global AUC is beside the point. 'lift' divides by prevalence -
    it is how many times better than random sampling the selection is, and a
    lift near 1 means the estimator adds nothing to picking at random.
    """
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    true_bad = (y_true > threshold).astype(int)
    k = min(int(k), len(y_true))
    if k == 0:
        return None

    top = np.argsort(-y_pred)[:k]
    precision = float(true_bad[top].mean())
    prevalence = float(true_bad.mean())

    return {
        "k": k,
        "precision_at_k": precision,
        "recall_at_k": float(true_bad[top].sum() / true_bad.sum())
        if true_bad.sum() else None,
        "prevalence": prevalence,
        "lift": float(precision / prevalence) if prevalence > 0 else None,
        "mean_true_wer_at_k": float(y_true[top].mean()),
    }


def stratification_check(y_true, y_pred, n_bins=4, n_splits=3, seed=0):
    """
    Does stratifying on the PREDICTED WER produce splits that are homogeneous
    in TRUE WER?

    Bins the data on the prediction, deals bins round-robin into n_splits, then
    reports the true WER mean per split. The spread across splits is what
    matters: it is the error you would actually inherit from using the
    estimator to build train/dev/test.

    'spread_stratified' is compared against 'spread_random' - the same spread
    from a purely random assignment. Stratification is only worth it if the
    first is clearly smaller.
    """
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    rng = np.random.default_rng(seed)

    edges = np.quantile(y_pred, np.linspace(0, 1, n_bins + 1)[1:-1])
    bins = np.digitize(y_pred, edges)

    assignment = np.zeros(len(y_true), dtype=int)
    for bin_index in range(n_bins):
        members = np.where(bins == bin_index)[0]
        rng.shuffle(members)
        assignment[members] = np.arange(len(members)) % n_splits

    random_assignment = rng.integers(0, n_splits, size=len(y_true))

    stratified = [float(y_true[assignment == s].mean()) for s in range(n_splits)]
    random_means = [float(y_true[random_assignment == s].mean())
                    for s in range(n_splits)]

    return {
        "n_bins": n_bins,
        "n_splits": n_splits,
        "true_wer_per_split": [round(v, 4) for v in stratified],
        "spread_stratified": round(max(stratified) - min(stratified), 4),
        "spread_random": round(max(random_means) - min(random_means), 4),
        "true_wer_overall": round(float(y_true.mean()), 4),
    }


def full_report(y_true, y_pred, threshold=BAD_THRESHOLD):
    """Regression plus good/bad verdict, in one call."""
    binary, matrix = binary_metrics(y_true, y_pred, threshold)
    return {
        "regression": regression_metrics(y_true, y_pred),
        "binary": binary,
        "confusion_matrix": matrix,
    }







def split_wer(rows, indices, weighting="duration"):
    """
    True WER of a set of segments, under one of the two defensible schemes.

    'duration': sum(wer_i * duration_i) / sum(duration_i). The scheme used
        everywhere else in this pipeline, because duration is the only weight
        available without references.
    'word': sum(errors_i) / sum(n_ref_words_i). The canonical corpus WER - the
        number you would report on a test set. Needs references, so it is an
        evaluation-time quantity only.

    Never use a plain mean of per-segment WERs: short segments carry unbounded
    WER values and would dominate.
    """
    subset = [rows[i] for i in indices]
    if not subset:
        return None

    if weighting == "word":
        total_ref = sum(r["n_ref_words"] for r in subset)
        return (float(sum(r["label_errors"] for r in subset) / total_ref)
                if total_ref else None)

    total_duration = sum(r["duration"] for r in subset)
    return (float(sum(r["label_wer"] * r["duration"] for r in subset)
                  / total_duration) if total_duration else None)




def stratification_check(rows, y_pred, n_bins=4, n_splits=3, seed=0,
                         weighting="duration", also_word_weighted=True):
    """
    Does stratifying on the PREDICTED WER produce splits homogeneous in TRUE WER?

    Bins the segments on the prediction, deals each bin round-robin into
    n_splits, then reports the true WER of each split. The spread across splits
    is the error you would actually inherit from using the estimator to build
    train/dev/test.

    'spread_stratified' is only meaningful against 'spread_random', the same
    spread under a purely random assignment: stratification is worth doing only
    if the first is clearly smaller.

    weighting selects the aggregation for the reported WER (see split_wer).
    also_word_weighted repeats the measurement under the canonical word-weighted
    scheme, so you can check the conclusion does not depend on that choice.
    """
    y_pred = np.asarray(y_pred, dtype=float)
    rng = np.random.default_rng(seed)

    edges = np.quantile(y_pred, np.linspace(0, 1, n_bins + 1)[1:-1])
    bins = np.digitize(y_pred, edges)

    assignment = np.zeros(len(rows), dtype=int)
    for bin_index in range(n_bins):
        members = np.where(bins == bin_index)[0]
        rng.shuffle(members)
        assignment[members] = np.arange(len(members)) % n_splits

    random_assignment = rng.integers(0, n_splits, size=len(rows))

    def spreads(scheme):
        stratified = [split_wer(rows, np.where(assignment == s)[0], scheme)
                      for s in range(n_splits)]
        random_means = [split_wer(rows, np.where(random_assignment == s)[0], scheme)
                        for s in range(n_splits)]
        return stratified, random_means

    stratified, random_means = spreads(weighting)
    report = {
        "n_bins": n_bins,
        "n_splits": n_splits,
        "weighting": weighting,
        "true_wer_per_split": [round(v, 4) for v in stratified],
        "spread_stratified": round(max(stratified) - min(stratified), 4),
        "spread_random": round(max(random_means) - min(random_means), 4),
        "true_wer_overall": round(
            split_wer(rows, range(len(rows)), weighting), 4),
    }

    if also_word_weighted and weighting != "word":
        word_strat, word_random = spreads("word")
        report.update({
            "word_wer_per_split": [round(v, 4) for v in word_strat],
            "word_spread_stratified": round(max(word_strat) - min(word_strat), 4),
            "word_spread_random": round(max(word_random) - min(word_random), 4),
            "word_wer_overall": round(split_wer(rows, range(len(rows)), "word"), 4),
        })

    return report
