"""
Deployment - fit once on everything, save, reload, predict without references.

cross_validate() in evaluate.py fits five models and throws them away: it
measures how well the method generalizes, it does not produce an artifact.
This module produces the artifact.

What inference needs, per segment:
    hyp_target_norm      the target system's hypothesis, normalized
    hyp_proxy_*_norm     at least one proxy hypothesis, normalized
    duration             segment duration in seconds
    sample_id            only for the call-level aggregation

What it does NOT need: the human reference. That is the whole point - the
reference exists only to build the training labels.

Critical: the normalization config used at inference must be the one frozen at
training time. The bundle carries it, and predict() refuses to run if the
caller passes a different one.
"""

import json
import os

import joblib
import numpy as np

from evaluate import make_model
from features import (PROXY_ROLES, block_of, extra_features,
                      proxy_features, text_features)

BUNDLE_VERSION = 1


# --------------------------------------------------------------------------
# Feature building without labels
# --------------------------------------------------------------------------

def features_for_inference(rows, blocks=("proxy", "text", "extra"),
                           roles=PROXY_ROLES):
    """
    Same features as training, computed from hypotheses alone.

    build_features() in features.py reads label_errors and label_wer, so it
    cannot run on unlabelled data. This is the label-free twin. Both call the
    identical proxy_features / text_features, so the columns are the same.
    """
    entries = []
    for row in rows:
        entry = {}
        if "proxy" in blocks:
            entry.update(proxy_features(row, roles))
        if "text" in blocks:
            entry.update(text_features(row))
        if "extra" in blocks:
            entry.update(extra_features(row, roles))
        entries.append(entry)
    return entries


def entries_to_matrix(entries, feature_names):
    """
    Dense matrix in the EXACT column order stored in the bundle.

    Rebuilding the order from the data would silently shuffle columns whenever
    a proxy is missing on some segments, which is the classic way a deployed
    model starts returning nonsense without raising anything.
    """
    matrix = np.zeros((len(entries), len(feature_names)), dtype=np.float64)
    for i, entry in enumerate(entries):
        for j, name in enumerate(feature_names):
            matrix[i, j] = float(entry.get(name, 0.0))
    return matrix


# --------------------------------------------------------------------------
# Training the final model
# --------------------------------------------------------------------------

def fit_final(rows, blocks=("proxy", "text", "extra"), target="wer",
              model="hgb",
              roles=PROXY_ROLES, norm_config=None, seed=0, notes=""):
    """
    Fit one model on ALL rows and return a self-describing bundle.

    Use the cross-validated scores as the honest performance estimate; this
    model is the deployment artifact, not a thing to re-score on its own
    training data.
    """
    entries = features_for_inference(rows, blocks, roles)
    feature_names = sorted({key for entry in entries for key in entry})
    feature_names = [n for n in feature_names if block_of(n) in blocks]
    matrix = entries_to_matrix(entries, feature_names)

    y = np.array(
        [r["label_errors"] if target == "errors" else r["label_wer"]
         for r in rows], dtype=float
    )

    estimator = make_model(model, seed)
    estimator.fit(matrix, y)

    return {
        "bundle_version": BUNDLE_VERSION,
        "estimator": estimator,
        "feature_names": feature_names,
        "blocks": tuple(blocks),
        "roles": tuple(roles),
        "target": target,
        "model": model,
        "norm_config": dict(norm_config or {}),
        "n_train_segments": len(rows),
        "n_train_calls": len({r["sample_id"] for r in rows}),
        "train_wer_mean": float(np.mean([r["label_wer"] for r in rows])),
        "notes": notes,
    }


def save_model(bundle, path):
    """Persist the bundle, plus a readable sidecar for auditing."""
    joblib.dump(bundle, path)
    sidecar = {k: v for k, v in bundle.items() if k != "estimator"}
    with open(os.path.splitext(path)[0] + ".json", "w", encoding="utf-8") as handle:
        json.dump(sidecar, handle, indent=1, ensure_ascii=False, default=str)
    return path


def load_model(path):
    """Reload a bundle saved by save_model."""
    bundle = joblib.load(path)
    if bundle.get("bundle_version") != BUNDLE_VERSION:
        raise ValueError(
            f"bundle version {bundle.get('bundle_version')} != {BUNDLE_VERSION}"
        )
    return bundle


# --------------------------------------------------------------------------
# Inference
# --------------------------------------------------------------------------

def predict(bundle, rows, norm_config=None):
    """
    Estimated WER per segment, from hypotheses only.

    Raises if the caller's normalization differs from the training one: a pWER
    computed under different conventions is not the feature the model was fit
    on, and the failure would otherwise be silent.
    """
    if norm_config is not None and bundle["norm_config"] and \
            dict(norm_config) != bundle["norm_config"]:
        raise ValueError(
            f"normalization mismatch: model trained with "
            f"{bundle['norm_config']}, called with {dict(norm_config)}"
        )

    entries = features_for_inference(rows, bundle["blocks"], bundle["roles"])
    matrix = entries_to_matrix(entries, bundle["feature_names"])
    raw = bundle["estimator"].predict(matrix)

    if bundle["target"] == "errors":
        lengths = np.array([
            max(len((r.get("hyp_target_norm") or "").split()), 1) for r in rows
        ], dtype=float)
        return np.clip(np.clip(raw, 0, None) / lengths, 0.0, 2.0)
    return np.clip(raw, 0.0, 2.0)


def predict_calls(bundle, rows, norm_config=None):
    """
    Estimated WER per call, weighting segment estimates by their duration.

    This is the operational output: a ranking of calls by expected
    transcription quality, with no reference anywhere in the chain.
    """
    estimates = predict(bundle, rows, norm_config)
    durations = np.array([r["duration"] for r in rows], dtype=float)
    groups = np.array([r["sample_id"] for r in rows])

    results = []
    for call in sorted(set(groups)):
        mask = groups == call
        weight = durations[mask].sum()
        if weight <= 0:
            continue
        results.append({
            "call": call,
            "n_segments": int(mask.sum()),
            "duration_s": round(float(weight), 1),
            "wer_estimated": round(
                float(np.sum(estimates[mask] * durations[mask]) / weight), 4),
        })
    results.sort(key=lambda item: -item["wer_estimated"])
    return results
